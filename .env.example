# Ruta base de la API. En desarrollo va por el proxy de Vite hacia Spring Boot (localhost:31026)
VITE_API_URL=/api

# Datos que imprime el carnet digital (pie y póliza del aprendiz). Si faltan se usan los del centro de Vélez;
# la póliza solo aparece si VITE_CARNET_ASEGURADORA tiene valor.
VITE_CARNET_REGIONAL=Regional Santander
VITE_CARNET_CENTRO=Centro de Gestión Agroempresarial del Oriente
VITE_CARNET_ASEGURADORA=
VITE_CARNET_ASEGURADORA_TEL=
VITE_CARNET_POLIZA=
